{
  "name": "squishy-lab",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:ai": "vite --mode ai-evaluation --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "measure:physics": "tsx scripts/measure-physics.ts",
    "measure:surface": "tsx scripts/measure-surface.ts",
    "measure:chocolate": "tsx scripts/measure-chocolate.ts",
    "record:chocolate": "tsx scripts/record-chocolate-pressure.ts",
    "record:experience": "tsx scripts/record-experience.ts",
    "record:collection": "tsx scripts/record-collection.ts",
    "measure:browser": "tsx scripts/measure-browser.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts",
    "worker:dev": "npm run build && wrangler dev --local --env mock",
    "worker:check": "wrangler deploy --env= --dry-run --outdir work/worker-build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/three": "0.183.1",
    "eslint": "10.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
