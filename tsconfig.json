{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "worker", "server", "api", "tests", "scripts", "*.ts"]
}
